{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowJs": false,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@night-food/ui/*": ["packages/ui/src/*"],
      "@night-food/types/*": ["packages/types/src/*"],
      "@night-food/lib/*": ["packages/lib/src/*"],
      "@night-food/config/*": ["packages/config/*"]
    }
  }
}


{
  "name": "night-food-family-platform",
  "private": true,
  "packageManager": "pnpm@10.17.0",
  "scripts": {
    "dev:web": "pnpm --filter @night-food/web dev",
    "dev:admin": "pnpm --filter @night-food/admin dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "cf:build:web": "pnpm --filter @night-food/web cf:build",
    "cf:build:admin": "pnpm --filter @night-food/admin cf:build",
    "cf:deploy:web": "pnpm --filter @night-food/web cf:deploy",
    "cf:deploy:admin": "pnpm --filter @night-food/admin cf:deploy",
    "docs:check": "node -e \"console.log('design docs ready')\"",
    "p0:readiness": "node scripts/p0-readiness.mjs",
    "phase1:readiness": "node scripts/phase1-readiness.mjs",
    "test:unit": "node --experimental-strip-types scripts/run-unit-tests.mjs",
    "test:e2e:list": "playwright test --list"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.38.0",
    "@opennextjs/cloudflare": "^1.9.1"
  }
}

{
	"easycom": {
		"^u-(.*)": "@/uni_modules/uview-ui/components/u-$1/u-$1.vue"
	},
	"pages": [ //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
		{
			"path": "pages/index/index",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "首页"
			}
		}, {
			"path": "pages/main/main",
			"style": {
				"navigationStyle": "custom",
				"navigationBarTitleText": "我的",
				"enablePullDownRefresh": false
			}

		}, {
			"path": "pages/task/task",
			"style": {
				"navigationBarTitleText": "任务中心",
				"enablePullDownRefresh": false
			}

		}, {
			"path": "pages/indent/indent",
			"style": {
				"navigationBarTitleText": "订单",
				"enablePullDownRefresh": false
			}

		}, {
			"path": "pages/order/order",
			"style": {
				"navigationBarTitleText": "点单",
				"enablePullDownRefresh": false
			}

		}, {
			"path": "pages/task/addTask",
			"style": {
				"navigationBarTitleText": "添加新任务",
				"enablePullDownRefresh": false
			}

		}, {
			"path": "pages/task/taskDetails",
			"style": {
				"navigationBarTitleText": "任务详情",
				"enablePullDownRefresh": false
			}

		}, {
			"path": "pages/main/coupon",
			"style": {
				"navigationBarTitleText": "我的卡卷",
				"enablePullDownRefresh": false
			}
		}, {
			"path": "pages/login/login",
			"style": {
				"navigationBarTitleText": "登录",
				"enablePullDownRefresh": false
			}

		}, {
			"path": "pages/main/userInfo",
			"style": {
				"navigationBarTitleText": "个人资料",
				"enablePullDownRefresh": false
			}

		}, {
			"path": "pages/main/updateUser",
			"style": {
				"enablePullDownRefresh": false,
				"navigationBarTitleText": "修改个人信息"
			}
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "black",
		"navigationBarTitleText": "夜食坊",
		"navigationBarBackgroundColor": "#F8F8F8",
		"backgroundColor": "#F8F8F8"
	},
	"uniIdRouter": {},
	"tabBar": {
		"color": "#000",
		"selectedColor": "#000",
		"borderStyle": "black",
		"backgroundColor": "#fff",
		"fontSize": "12px",
		"height": "50px",
		"list": [{
			"pagePath": "pages/index/index",
			"iconPath": "static/images/tabbar/index.png",
			"selectedIconPath": "static/images/tabbar/index2.png",
			"text": "首页"
		}, {
			"pagePath": "pages/order/order",
			"iconPath": "static/images/tabbar/order.png",
			"selectedIconPath": "static/images/tabbar/order1.png",
			"text": "点单"
		}, {
			"pagePath": "pages/indent/indent",
			"iconPath": "static/images/tabbar/indent.png",
			"selectedIconPath": "static/images/tabbar/indent1.png",
			"text": "订单"
		}, {
			"pagePath": "pages/task/task",
			"iconPath": "static/images/tabbar/task.png",
			"selectedIconPath": "static/images/tabbar/task1.png",
			"text": "任务中心"
		}, {
			"pagePath": "pages/main/main",
			"iconPath": "static/images/tabbar/main.png",
			"selectedIconPath": "static/images/tabbar/main1.png",
			"text": "我的"
		}]
	}
}

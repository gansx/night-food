FROM node:20-bookworm-slim

ARG APP_SCOPE
ARG APP_DIR
ARG NEXT_PUBLIC_BASE_PATH
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_ADMIN_SITE_URL
ARG NEXT_PUBLIC_SUPABASE_URL
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY
ARG PORT=3000

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV NODE_ENV=production
ENV APP_SCOPE="$APP_SCOPE"
ENV APP_DIR="$APP_DIR"
ENV PORT="$PORT"
ENV HOSTNAME=0.0.0.0
ENV NEXT_PUBLIC_BASE_PATH="$NEXT_PUBLIC_BASE_PATH"
ENV NEXT_PUBLIC_SITE_URL="$NEXT_PUBLIC_SITE_URL"
ENV NEXT_PUBLIC_ADMIN_SITE_URL="$NEXT_PUBLIC_ADMIN_SITE_URL"
ENV NEXT_PUBLIC_SUPABASE_URL="$NEXT_PUBLIC_SUPABASE_URL"
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY="$NEXT_PUBLIC_SUPABASE_ANON_KEY"

RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages

RUN pnpm install --frozen-lockfile
RUN pnpm --filter "$APP_SCOPE" build

EXPOSE $PORT

CMD ["sh", "-lc", "pnpm --filter \"$APP_SCOPE\" exec next start --port \"$PORT\" --hostname 0.0.0.0"]

